# ==========================================================================
#  חוג לכל ילד - בוט ווטסאפ | קובץ הגדרות לדוגמה
#  העתיקו לקובץ .env ומלאו. אין להעלות את .env ל-git לעולם.
# ==========================================================================

# --- Anthropic (Claude) ---------------------------------------------------
# מפתח מ- console.anthropic.com  (לא מנוי claude.ai)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  - מאזן בין עומק חשיבה לעלות
CLAUDE_EFFORT=medium

# --- WhatsApp (Meta Cloud API) -------------------------------------------
WHATSAPP_PROVIDER=meta
# מזהה מספר הטלפון מתוך Meta Business -> WhatsApp -> API Setup
META_PHONE_NUMBER_ID=
# טוקן קבוע (System User Token) - לא טוקן זמני של 24 שעות
META_ACCESS_TOKEN=
# App Secret מתוך Meta App -> Settings -> Basic. משמש לאימות חתימת ה-webhook
META_APP_SECRET=
# מחרוזת שאתם ממציאים, ומזינים גם בהגדרת ה-Webhook בפאנל של מטא
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- הצפנה מקומית --------------------------------------------------------
# הריצו `npm run keys` כדי לייצר את שני הערכים האלה.
# אובדן המפתח = אובדן כל היסטוריית השיחות. גבו אותו בנפרד מהשרת.
DATA_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=

# --- הסלמה לנציג אנושי ---------------------------------------------------
# מספר הווטסאפ שלך, בפורמט בינלאומי בלי + (לדוגמה 972501234567)
MANAGER_PHONE=
MANAGER_NAME=נדב
# כמה שעות הבוט שותק אחרי העברה לנציג
HUMAN_HANDOFF_HOURS=24

# --- שמירת מידע ----------------------------------------------------------
# אחרי כמה ימים נמחק תוכן ההודעות הגולמי (המוצפן).
# הטקסט המנוקה מזיהוי נשמר לצמיתות לצורך ניתוח פנימי. 0 = לא למחוק.
RAW_RETENTION_DAYS=180

# --- כללי ----------------------------------------------------------------
PORT=3000
DB_PATH=./data/bot.db
KNOWLEDGE_DIR=./knowledge
LOG_LEVEL=info
# מצב יבש: מקבל הודעות ומריץ את המודל, אך לא שולח תשובות בפועל
DRY_RUN=false
